{
  "name": "dsh-mobile-layout",
  "version": "0.6.1",
  "description": "Mobile experience suite for the DeepSeek Harness web UI — reading layout (<1024px drawer sidebar + whale button), aurora glass skinning with auto text contrast, file-browser tab, sidebar file upload to the workspace, abort auto-heal. Zero dependencies.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crwsr124/dsh-mobile-layout.git"
  },
  "homepage": "https://github.com/crwsr124/dsh-mobile-layout#readme",
  "bugs": {
    "url": "https://github.com/crwsr124/dsh-mobile-layout/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "mobile",
    "skin",
    "theme",
    "aurora",
    "glass",
    "upload",
    "dsh-plugin"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [],
      "immediately": true
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
