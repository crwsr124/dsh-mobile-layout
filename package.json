{
	"name": "dsh-mobile-layout",
	"version": "0.9.7",
	"description": "Mobile experience suite for the DeepSeek Harness web UI — responsive reading layout, composable glass skinning, download affordances for the built-in 0.1.5 files sidebar, and session-state healing. Zero package dependencies.",
	"type": "module",
	"main": "lib/index.js",
	"exports": {
		".": {
			"default": "./lib/index.js"
		},
		"./client": {
			"default": "./lib/client.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"lib/index.js",
		"lib/client.js",
		"cordis.patch.yml"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/crwsr124/dsh-mobile-layout.git"
	},
	"homepage": "https://github.com/crwsr124/dsh-mobile-layout#readme",
	"bugs": {
		"url": "https://github.com/crwsr124/dsh-mobile-layout/issues"
	},
	"keywords": [
		"dsh",
		"deepseek-harness",
		"mobile",
		"skin",
		"theme",
		"aurora",
		"glass",
		"dsh-plugin"
	],
	"dsh": {
		"client": {
			"platform": "web",
			"inject": [
				"slots",
				"theme",
				"sessions"
			],
			"immediately": true
		},
		"bundle": {
			"patch": "./cordis.patch.yml"
		}
	}
}
