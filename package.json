{
  "name": "dsh-mobile-layout",
  "description": "dsh web 移动端体验套件：<1024px 阅读布局（抽屉侧栏+鲸鱼按钮/字体密度/表格/输入框滚动收起）+ 极光玻璃换肤（含文字对比度自动适配）+ 文件浏览器页签 + abort 错误自愈（零依赖）",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [],
      "immediately": true
    }
  },
  "license": "MIT"
}
